{
	"compilerOptions": {
    "allowJs": true,
    "downlevelIteration": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "jsx": "react",
    "lib": ["dom", "es5", "scripthost", "es2020.bigint", "es2015.collection"],
		"module": "commonjs",
		"moduleResolution": "node",
		"outDir": "../built",
		"resolveJsonModule": true,
    "sourceMap": true,
    "target": "ES2020"
	},
  "include": ["../lib/**/*.ts", "../index/full.ts"],
	"exclude": ["../node_modules", "../bundler", "../lib/saito/*.js", "../lib/ui/**/*"]
}